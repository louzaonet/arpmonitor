#!/bin/sh /etc/rc.common
# Script de init procd para arpmonitord.
# Copyright (C) 2026 Jorge Louzao Penalva. Licencia GNU AGPL v3.
# Instalar como /etc/init.d/arpmonitor y luego:
#   chmod +x /etc/init.d/arpmonitor
#   /etc/init.d/arpmonitor enable
#   /etc/init.d/arpmonitor start

USE_PROCD=1
START=95
STOP=10

# Ajusta estos valores
MAIL_TO="tu@correo.com"
INTERVAL=30
DB="/root/arpmonitor.db"

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/arpmonitord.py \
		--to "$MAIL_TO" --interval "$INTERVAL" --db "$DB"
	# stdout/stderr van a syslog, se ve con `logread -e arpmonitor`
	procd_set_param stderr 1
	procd_set_param stdout 1
	# Reinicia si muere: umbral 3600s, espera 5s, 5 intentos
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
